# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (never exposed to the client). Used by provisioning scripts and
# the invite-accept path.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Comma-separated emails allowed into the /admin tenant console (server-only).
SUPER_ADMIN_EMAILS=

# ── Email (optional) ──────────────────────────────────────────────────────────
# Invite emails are sent via Resend ONLY when RESEND_API_KEY is set. Leave it
# blank to run without email — the invite UI still shows a copyable link.
RESEND_API_KEY=
# Verified sender (Resend → Domains). For quick testing you can use Resend's
# onboarding domain, which only delivers to your own account email.
EMAIL_FROM=Artisan Project Hub <onboarding@resend.dev>
# Absolute base URL used to build links inside emails (server has no origin).
APP_URL=http://localhost:3000
